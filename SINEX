--// Accept Quest
local function AcceptQuest(questData)
    if not questData then return false end

    local questNPC = Workspace.NPCs:FindFirstChild(questData.NPC)
    if questNPC and questNPC:FindFirstChild("HumanoidRootPart") then
        local distance = (RootPart.Position - questNPC.HumanoidRootPart.Position).Magnitude
        if distance < 10 then
            -- Simulate quest acceptance
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questData.NPC, questData.Level)
            return true
        end
    end
    return false
end

--// Attack Enemy
local function AttackEnemy(enemy)
    if not enemy or not enemy:FindFirstChild("HumanoidRootPart") then return end

    -- Teleport to enemy
    RootPart.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)

    -- Equip weapon
    local tool = Character:FindFirstChildOfClass("Tool")
    if not tool then
        -- Try to equip selected weapon
        for _, item in pairs(Player.Backpack:GetChildren()) do
            if item:IsA("Tool") then
                Humanoid:EquipTool(item)
                break
            end
        end
    end

    -- Attack
    if getgenv().Settings.FastAttack then
        -- Fast attack method
        for i = 1, 5 do
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(0, 0))
            task.wait(0.1)
            VirtualUser:Button1Up(Vector2.new(0, 0))
        end
    else
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(0, 0))
        task.wait(0.3)
        VirtualUser:Button1Up(Vector2.new(0, 0))
    end

    TotalKills = TotalKills + 1
end

--// Auto Farm Loop
local function StartFarm()
    if FarmConnection then FarmConnection:Disconnect() end

    FarmConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().Settings.AutoFarm then return end

        local playerLevel = GetPlayerLevel()
        if playerLevel >= MAX_LEVEL then
            Luna:Notification({
                Title = "Max Level Reached!",
                Content = "You have reached the maximum level: " .. MAX_LEVEL,
                Time = 10
            })
            SendWebhook("Max Level Reached!", "Congratulations! You have reached level " .. MAX_LEVEL)
            getgenv().Settings.AutoFarm = false
            return
        end

        -- Get quest and enemy
        local questData = GetQuestNPC()
        if questData and getgenv().Settings.AutoQuest then
            AcceptQuest(questData)
        end

        local enemy = GetClosestEnemy(playerLevel + 50)
        if enemy then
            CurrentTarget = enemy
            AttackEnemy(enemy)
        end
    end)
end

local function StopFarm()
    if FarmConnection then
        FarmConnection:Disconnect()
        FarmConnection = nil
    end
    CurrentTarget = nil
end

