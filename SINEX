--// Utility Functions
local function GetPlayerLevel()
    local level = Player:FindFirstChild("Data") and Player.Data:FindFirstChild("Level")
    return level and level.Value or 0
end

local function GetPlayerMoney()
    local money = Player:FindFirstChild("Data") and Player.Data:FindFirstChild("Money")
    return money and money.Value or 0
end

local function GetCurrentSea()
    local placeId = game.PlaceId
    if placeId == 2753915549 then return "First Sea"
    elseif placeId == 4442272183 then return "Second Sea"
    elseif placeId == 7449423635 then return "Third Sea"
    end
    return "Unknown"
end

local function SendWebhook(title, message)
    if not getgenv().Settings.WebhookEnabled or getgenv().Settings.WebhookURL == "" then return end

    local data = {
        ["embeds"] = {{
            ["title"] = title,
            ["description"] = message,
            ["color"] = 5814783,
            ["fields"] = {
                {["name"] = "Level", ["value"] = tostring(GetPlayerLevel()), ["inline"] = true},
                {["name"] = "Money", ["value"] = tostring(GetPlayerMoney()), ["inline"] = true},
                {["name"] = "Sea", ["value"] = GetCurrentSea(), ["inline"] = true},
                {["name"] = "Kills", ["value"] = tostring(TotalKills), ["inline"] = true},
                {["name"] = "Runtime", ["value"] = tostring(math.floor(tick() - FarmStartTime)) .. "s", ["inline"] = true}
            },
            ["footer"] = {["text"] = "Blox Fruits Auto Farm | " .. os.date("%Y-%m-%d %H:%M:%S")}
        }}
    }

    local success, err = pcall(function()
        HttpService:PostAsync(getgenv().Settings.WebhookURL, HttpService:JSONEncode(data))
    end)

    if not success then
        warn("Webhook Error: " .. tostring(err))
    end
end

