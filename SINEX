                    for _, chest in pairs(Workspace:GetChildren()) do
                        if chest.Name:find("Chest") and chest:FindFirstChild("TouchInterest") then
                            firetouchinterest(RootPart, chest.TouchInterest, 0)
                            firetouchinterest(RootPart, chest.TouchInterest, 1)
                        end
                    end
                end
            end)
        end
    end
})

